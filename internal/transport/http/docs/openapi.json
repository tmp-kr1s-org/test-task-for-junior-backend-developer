{
  "openapi": "3.0.3",
  "info": {
    "title": "Task Service API",
    "version": "1.1.0",
    "description": "CRUD API for tasks built with clean architecture. Recurring tasks supported via optional repeat rules and per-occurrence overrides."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "tags": [
    {
      "name": "Tasks",
      "description": "Operations with tasks"
    },
    {
      "name": "Recurring",
      "description": "Recurring task operations: per-day overrides and series forks"
    }
  ],
  "paths": {
    "/api/v1/tasks": {
      "get": {
        "tags": ["Tasks"],
        "summary": "List tasks (or expanded occurrences when from/to provided)",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date" },
            "description": "Window start (YYYY-MM-DD). When set together with `to`, the response is a list of materialized occurrences instead of raw tasks."
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date" }
          }
        ],
        "responses": {
          "200": {
            "description": "Task list (or occurrence list when range is given)",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Task" }
                    },
                    {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Occurrence" }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      },
      "post": {
        "tags": ["Tasks"],
        "summary": "Create task (optionally recurring)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateTaskRequest" },
              "examples": {
                "one_off": {
                  "summary": "One-off task (no repeat)",
                  "value": {
                    "title": "Prepare release",
                    "description": "Collect release notes",
                    "status": "new",
                    "scheduled_at": "2026-04-25T09:00:00Z"
                  }
                },
                "daily_every_2": {
                  "summary": "Daily, every 2 days",
                  "value": {
                    "title": "Standup",
                    "scheduled_at": "2026-04-28T09:00:00Z",
                    "repeat": {
                      "type": "daily",
                      "start_date": "2026-04-28",
                      "interval_days": 2
                    }
                  }
                },
                "weekly_mon_wed_fri": {
                  "summary": "Weekly: Mon/Wed/Fri",
                  "value": {
                    "title": "Gym",
                    "scheduled_at": "2026-04-27T18:00:00Z",
                    "repeat": {
                      "type": "weekly",
                      "start_date": "2026-04-27",
                      "weekdays": [1, 3, 5]
                    }
                  }
                },
                "monthly_1_and_15": {
                  "summary": "Monthly on 1st and 15th",
                  "value": {
                    "title": "Payroll check",
                    "scheduled_at": "2026-05-01T10:00:00Z",
                    "repeat": {
                      "type": "monthly",
                      "start_date": "2026-05-01",
                      "month_days": [1, 15]
                    }
                  }
                },
                "specific_dates": {
                  "summary": "Specific dates only",
                  "value": {
                    "title": "Conference talks",
                    "repeat": {
                      "type": "specific_dates",
                      "specific_dates": ["2026-05-12", "2026-05-13", "2026-05-14"]
                    }
                  }
                },
                "even_days": {
                  "summary": "Even calendar days",
                  "value": {
                    "title": "Watering",
                    "scheduled_at": "2026-04-28T07:00:00Z",
                    "repeat": {
                      "type": "even_days",
                      "start_date": "2026-04-28"
                    }
                  }
                },
                "odd_days": {
                  "summary": "Odd calendar days, with end_date",
                  "value": {
                    "title": "Meds",
                    "scheduled_at": "2026-04-29T08:00:00Z",
                    "repeat": {
                      "type": "odd_days",
                      "start_date": "2026-04-29",
                      "end_date": "2026-06-30"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/tasks/{id}": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Get task by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Tasks"],
        "summary": "Update task",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateTaskRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Tasks"],
        "summary": "Delete task",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "responses": {
          "204": { "description": "Deleted" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/tasks/{id}/occurrences/{date}": {
      "put": {
        "tags": ["Recurring"],
        "summary": "Upsert per-day override for a recurring task",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64", "minimum": 1 } },
          { "name": "date", "in": "path", "required": true, "schema": { "type": "string", "format": "date" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Override" }
            }
          }
        },
        "responses": {
          "204": { "description": "Override applied" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Recurring"],
        "summary": "Cancel a single occurrence (tombstone)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64", "minimum": 1 } },
          { "name": "date", "in": "path", "required": true, "schema": { "type": "string", "format": "date" } }
        ],
        "responses": {
          "204": { "description": "Cancelled" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/tasks/{id}/fork": {
      "post": {
        "tags": ["Recurring"],
        "summary": "Fork series at a given date (\"this and following\")",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64", "minimum": 1 } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ForkRequest" },
              "examples": {
                "daily_every_2": {
                  "summary": "Fork to daily, every 2 days",
                  "value": {
                    "from_date": "2026-05-05",
                    "title": "Standup",
                    "description": "Daily sync",
                    "status": "new",
                    "scheduled_at": "2026-05-05T09:00:00Z",
                    "repeat": {
                      "type": "daily",
                      "interval_days": 2,
                      "end_date": "2026-06-30"
                    }
                  }
                },
                "weekly_mon_wed_fri": {
                  "summary": "Fork to weekly: Mon/Wed/Fri",
                  "value": {
                    "from_date": "2026-05-04",
                    "title": "Gym",
                    "description": "",
                    "status": "new",
                    "scheduled_at": "2026-05-04T18:00:00Z",
                    "repeat": {
                      "type": "weekly",
                      "weekdays": [1, 3, 5]
                    }
                  }
                },
                "monthly_1_and_15": {
                  "summary": "Fork to monthly on 1st and 15th",
                  "value": {
                    "from_date": "2026-06-01",
                    "title": "Payroll check",
                    "description": "",
                    "status": "new",
                    "scheduled_at": "2026-06-01T10:00:00Z",
                    "repeat": {
                      "type": "monthly",
                      "month_days": [1, 15]
                    }
                  }
                },
                "specific_dates": {
                  "summary": "Fork to specific dates only",
                  "value": {
                    "from_date": "2026-05-12",
                    "title": "Conference talks",
                    "description": "",
                    "status": "new",
                    "repeat": {
                      "type": "specific_dates",
                      "specific_dates": ["2026-05-12", "2026-05-13", "2026-05-14"]
                    }
                  }
                },
                "even_days": {
                  "summary": "Fork to even calendar days",
                  "value": {
                    "from_date": "2026-05-02",
                    "title": "Watering",
                    "description": "",
                    "status": "new",
                    "scheduled_at": "2026-05-02T07:00:00Z",
                    "repeat": {
                      "type": "even_days"
                    }
                  }
                },
                "odd_days_with_end": {
                  "summary": "Fork to odd calendar days, with end_date",
                  "value": {
                    "from_date": "2026-05-03",
                    "title": "Meds",
                    "description": "",
                    "status": "new",
                    "scheduled_at": "2026-05-03T08:00:00Z",
                    "repeat": {
                      "type": "odd_days",
                      "end_date": "2026-06-30"
                    }
                  }
                },
                "no_repeat_change": {
                  "summary": "Fork without changing the rule (inherits old series)",
                  "value": {
                    "from_date": "2026-05-05",
                    "title": "Standup (renamed)",
                    "description": "Daily sync",
                    "status": "new",
                    "scheduled_at": "2026-05-05T09:00:00Z"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "New task representing the forked series",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "BadRequest": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "CreateTaskRequest": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "example": "Prepare release" },
          "description": { "type": "string", "example": "Collect release notes" },
          "status": { "type": "string", "enum": ["new", "in_progress", "done"], "example": "new" },
          "scheduled_at": { "type": "string", "format": "date-time", "example": "2026-04-25T09:00:00Z" },
          "repeat": { "$ref": "#/components/schemas/RepeatRule" }
        }
      },
      "UpdateTaskRequest": {
        "type": "object",
        "required": ["title", "status"],
        "properties": {
          "title": { "type": "string", "example": "Prepare release" },
          "description": { "type": "string", "example": "Collect release notes" },
          "status": { "type": "string", "enum": ["new", "in_progress", "done"], "example": "in_progress" },
          "scheduled_at": { "type": "string", "format": "date-time", "example": "2026-04-25T09:00:00Z" }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "example": 1 },
          "title": { "type": "string", "example": "Prepare release" },
          "description": { "type": "string", "example": "Collect release notes" },
          "status": { "type": "string", "enum": ["new", "in_progress", "done"], "example": "new" },
          "scheduled_at": { "type": "string", "format": "date-time", "nullable": true, "example": "2026-04-25T09:00:00Z" },
          "created_at": { "type": "string", "format": "date-time", "example": "2026-03-24T00:00:00Z" },
          "updated_at": { "type": "string", "format": "date-time", "example": "2026-03-24T00:00:00Z" },
          "repeat": {
            "description": "Recurrence rule attached to this task; present only on GET /tasks/{id} when the task is recurring.",
            "allOf": [{ "$ref": "#/components/schemas/RepeatRule" }],
            "nullable": true
          }
        }
      },
      "RepeatRule": {
        "description": "Recurrence rule. Each `type` uses its own parameter set; passing parameters that don't belong to the chosen `type` returns 400.",
        "oneOf": [
          { "$ref": "#/components/schemas/RepeatDaily" },
          { "$ref": "#/components/schemas/RepeatWeekly" },
          { "$ref": "#/components/schemas/RepeatMonthly" },
          { "$ref": "#/components/schemas/RepeatSpecificDates" },
          { "$ref": "#/components/schemas/RepeatEvenDays" },
          { "$ref": "#/components/schemas/RepeatOddDays" }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "daily": "#/components/schemas/RepeatDaily",
            "weekly": "#/components/schemas/RepeatWeekly",
            "monthly": "#/components/schemas/RepeatMonthly",
            "specific_dates": "#/components/schemas/RepeatSpecificDates",
            "even_days": "#/components/schemas/RepeatEvenDays",
            "odd_days": "#/components/schemas/RepeatOddDays"
          }
        }
      },
      "RepeatWindow": {
        "type": "object",
        "properties": {
          "start_date": { "type": "string", "format": "date", "description": "Anchor day. Defaults to `scheduled_at`'s date if omitted." },
          "end_date":   { "type": "string", "format": "date", "nullable": true, "description": "Inclusive last day; null/omitted means open-ended." }
        }
      },
      "RepeatDaily": {
        "allOf": [
          { "$ref": "#/components/schemas/RepeatWindow" },
          {
            "type": "object",
            "required": ["type", "interval_days"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string", "enum": ["daily"] },
              "start_date": { "type": "string", "format": "date" },
              "end_date":   { "type": "string", "format": "date", "nullable": true },
              "interval_days": { "type": "integer", "minimum": 1, "example": 2 }
            }
          }
        ]
      },
      "RepeatWeekly": {
        "allOf": [
          { "$ref": "#/components/schemas/RepeatWindow" },
          {
            "type": "object",
            "required": ["type", "weekdays"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string", "enum": ["weekly"] },
              "start_date": { "type": "string", "format": "date" },
              "end_date":   { "type": "string", "format": "date", "nullable": true },
              "weekdays": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "integer", "minimum": 1, "maximum": 7 },
                "description": "1=Mon..7=Sun",
                "example": [1, 3, 5]
              }
            }
          }
        ]
      },
      "RepeatMonthly": {
        "allOf": [
          { "$ref": "#/components/schemas/RepeatWindow" },
          {
            "type": "object",
            "required": ["type", "month_days"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string", "enum": ["monthly"] },
              "start_date": { "type": "string", "format": "date" },
              "end_date":   { "type": "string", "format": "date", "nullable": true },
              "month_days": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "integer", "minimum": 1, "maximum": 30 },
                "description": "Days of month (capped at 30 to keep months comparable).",
                "example": [1, 15]
              }
            }
          }
        ]
      },
      "RepeatSpecificDates": {
        "allOf": [
          { "$ref": "#/components/schemas/RepeatWindow" },
          {
            "type": "object",
            "required": ["type", "specific_dates"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string", "enum": ["specific_dates"] },
              "start_date": { "type": "string", "format": "date" },
              "end_date":   { "type": "string", "format": "date", "nullable": true },
              "specific_dates": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "format": "date" },
                "example": ["2026-05-12", "2026-05-13"]
              }
            }
          }
        ]
      },
      "RepeatEvenDays": {
        "allOf": [
          { "$ref": "#/components/schemas/RepeatWindow" },
          {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string", "enum": ["even_days"] },
              "start_date": { "type": "string", "format": "date" },
              "end_date":   { "type": "string", "format": "date", "nullable": true }
            }
          }
        ]
      },
      "RepeatOddDays": {
        "allOf": [
          { "$ref": "#/components/schemas/RepeatWindow" },
          {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string", "enum": ["odd_days"] },
              "start_date": { "type": "string", "format": "date" },
              "end_date":   { "type": "string", "format": "date", "nullable": true }
            }
          }
        ]
      },
      "Occurrence": {
        "allOf": [
          { "$ref": "#/components/schemas/Task" },
          {
            "type": "object",
            "required": ["date"],
            "properties": {
              "date": { "type": "string", "format": "date", "example": "2026-04-29" }
            }
          }
        ]
      },
      "Override": {
        "type": "object",
        "description": "All fields are optional. Null/missing means inherit from series. To cancel a single occurrence use DELETE /api/v1/tasks/{id}/occurrences/{date}.",
        "properties": {
          "title": { "type": "string", "nullable": true },
          "description": { "type": "string", "nullable": true },
          "status": { "type": "string", "enum": ["new", "in_progress", "done"], "nullable": true },
          "scheduled_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "ForkRequest": {
        "type": "object",
        "required": ["from_date", "title", "status"],
        "properties": {
          "from_date": { "type": "string", "format": "date", "description": "Day from which the new series starts. Old series is capped at the previous day." },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "status": { "type": "string", "enum": ["new", "in_progress", "done"] },
          "scheduled_at": { "type": "string", "format": "date-time", "nullable": true },
          "repeat": { "$ref": "#/components/schemas/ForkRepeatRule" }
        }
      },
      "ForkRepeatRule": {
        "description": "Same as RepeatRule but `start_date` is omitted: the new series always anchors at `from_date`.",
        "oneOf": [
          { "$ref": "#/components/schemas/ForkRepeatDaily" },
          { "$ref": "#/components/schemas/ForkRepeatWeekly" },
          { "$ref": "#/components/schemas/ForkRepeatMonthly" },
          { "$ref": "#/components/schemas/ForkRepeatSpecificDates" },
          { "$ref": "#/components/schemas/ForkRepeatEvenDays" },
          { "$ref": "#/components/schemas/ForkRepeatOddDays" }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "daily": "#/components/schemas/ForkRepeatDaily",
            "weekly": "#/components/schemas/ForkRepeatWeekly",
            "monthly": "#/components/schemas/ForkRepeatMonthly",
            "specific_dates": "#/components/schemas/ForkRepeatSpecificDates",
            "even_days": "#/components/schemas/ForkRepeatEvenDays",
            "odd_days": "#/components/schemas/ForkRepeatOddDays"
          }
        }
      },
      "ForkRepeatDaily": {
        "type": "object",
        "required": ["type", "interval_days"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "enum": ["daily"] },
          "end_date": { "type": "string", "format": "date", "nullable": true },
          "interval_days": { "type": "integer", "minimum": 1, "example": 2 }
        }
      },
      "ForkRepeatWeekly": {
        "type": "object",
        "required": ["type", "weekdays"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "enum": ["weekly"] },
          "end_date": { "type": "string", "format": "date", "nullable": true },
          "weekdays": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 1, "maximum": 7 },
            "description": "1=Mon..7=Sun",
            "example": [1, 3, 5]
          }
        }
      },
      "ForkRepeatMonthly": {
        "type": "object",
        "required": ["type", "month_days"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "enum": ["monthly"] },
          "end_date": { "type": "string", "format": "date", "nullable": true },
          "month_days": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 1, "maximum": 30 },
            "example": [1, 15]
          }
        }
      },
      "ForkRepeatSpecificDates": {
        "type": "object",
        "required": ["type", "specific_dates"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "enum": ["specific_dates"] },
          "end_date": { "type": "string", "format": "date", "nullable": true },
          "specific_dates": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "format": "date" },
            "example": ["2026-05-12", "2026-05-13"]
          }
        }
      },
      "ForkRepeatEvenDays": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "enum": ["even_days"] },
